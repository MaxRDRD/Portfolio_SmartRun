# ==============================================================================
# SmartRun Environment Configuration Example
# Скопируйте данный файл в .env и укажите актуальные значения для окружения.
# ==============================================================================

# Приложение и Порт
APP_ENV=development
PORT=8080
APP_PUBLIC_URL=http://localhost:8080
LOG_LEVEL=info

# База данных PostgreSQL (pgx pool)
CONN_STRING=postgres://smartrun:smartrun@localhost:5432/smartrun?sslmode=disable

# Кэш Redis
# В Docker Compose: redis://redis:6379
# Для локального запуска: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Брокер сообщений RabbitMQ
RABBITMQ_URL=amqp://smartrun:smartrun@localhost:5672/

# Безопасность и Аутентификация
SECRET_KEY=dev-only-change-in-production-secret-key
JWT_SECRET=dev-only-super-secret-change-me-jwt-token-32bytes
TOTP_MASTER_KEY=dev-only-totp-encryption-key-must-be-32bytes-base64=

# AI Coach (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Почтовый сервис (SMTP для сброса паролей через EmailWorker)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourapp@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@smartrun.app
